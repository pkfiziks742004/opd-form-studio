# Application Environment (production or local)
APP_ENV=production
APP_NAME="OPD Form Studio"
APP_URL=https://yourdomain.com
APP_TIMEZONE=Asia/Kolkata

# Hostinger MySQL Database Settings
# Note: On Hostinger hPanel, DB_HOST is usually 'localhost'
# Database name and user usually have a prefix like: u123456789_opd
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u123456789_opd
DB_USER=u123456789_opd_user
DB_PASS=your_strong_mysql_password

# Secret key for first-time installation (open https://yourdomain.com/setup.php?key=YOUR_KEY)
SETUP_KEY=generate-a-random-secret-key-for-installation

# Secret key for sheet sync cron (run via Hostinger Cron Jobs)
CRON_KEY=generate-a-second-secret-key-for-cron

# ==============================================================================
# OPD Form Studio - Hostinger Production Apache / LiteSpeed Configuration
# ==============================================================================

# Disable directory browsing
Options -Indexes

# Set default charset
AddDefaultCharset UTF-8

# Block direct access to hidden files and sensitive configuration
<FilesMatch "(^\.env|^\.git|^\.htaccess|\.sql$|\.log$|README\.md$|DEPLOYMENT\.md$)">
    Require all denied
</FilesMatch>

# Block direct execution/access to sensitive directories
RewriteEngine On

# Protect internal directories
RewriteRule ^(?:includes|database|apps-script)/ - [F,L]

# Optional Security Headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Browser Caching for static assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
</IfModule>
